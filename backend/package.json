{
  "name": "kupito-backend",
  "version": "1.0.0",
  "description": "Backend API для Kupito",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "npx nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "start": "npx nest start",
    "start:dev": "npx nest start --watch",
    "start:debug": "npx nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" --fix --ignore-pattern '*.spec.ts' --ignore-pattern '*.test.ts' --ignore-pattern '*.integration.ts' --ignore-pattern 'src/test/**'",
    "lint:check": "eslint \"src/**/*.ts\" --ignore-pattern '*.spec.ts' --ignore-pattern '*.test.ts' --ignore-pattern '*.integration.ts' --ignore-pattern 'src/test/**'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest-integration.config.cjs",
    "test:integration:watch": "NODE_OPTIONS=--experimental-vm-modules jest --config jest-integration.config.cjs --watch",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "seed": "ts-node -r tsconfig-paths/register src/scripts/stage/seed.ts",
    "reset-and-seed": "ts-node -r tsconfig-paths/register src/scripts/stage/reset-and-seed.ts",
    "clear-cache": "ts-node -r tsconfig-paths/register src/scripts/stage/clear-cache.ts",
    "clear-cache:listings": "ts-node -r tsconfig-paths/register src/scripts/stage/clear-listing-cache.ts",
    "clear-cache:listing": "ts-node -r tsconfig-paths/register src/scripts/stage/clear-listing-cache.ts",
    "clear-cache:brands": "ts-node -r tsconfig-paths/register src/scripts/stage/clear-brands-cache.ts",
    "copy-seed-images": "ts-node -r tsconfig-paths/register src/scripts/stage/copy-images-to-seed.ts",
    "create-test-listing": "ts-node -r tsconfig-paths/register src/scripts/stage/create-test-listing.ts",
    "seed:vin": "ts-node -r tsconfig-paths/register src/scripts/stage/seed-vin-test.ts",
    "fix-price-nulls": "ts-node -r tsconfig-paths/register src/scripts/stage/fix-price-nulls.ts",
    "seed:vehicles": "ts-node -r tsconfig-paths/register src/scripts/stage/seed-vehicles-full.ts",
    "make-admin": "ts-node -r tsconfig-paths/register src/scripts/stage/make-admin.ts",
    "make-admin:prod": "ts-node -r tsconfig-paths/register src/scripts/production/make-admin.ts",
    "remove-admin:prod": "ts-node -r tsconfig-paths/register src/scripts/production/remove-admin.ts",
    "fix-price-nulls:prod": "ts-node -r tsconfig-paths/register src/scripts/production/fix-price-nulls.ts",
    "seed:all-brands:prod": "ts-node -r tsconfig-paths/register src/scripts/production/seed-all-brands.ts",
    "add-truck-brands:prod": "ts-node -r tsconfig-paths/register src/scripts/production/add-truck-brands-models.ts",
    "add-moto-brands:prod": "ts-node -r tsconfig-paths/register src/scripts/production/add-motorcycle-brands-models.ts",
    "check-brands:prod": "ts-node -r tsconfig-paths/register src/scripts/production/check-brands-count.ts",
    "check-models:prod": "ts-node -r tsconfig-paths/register src/scripts/production/check-models-stats.ts",
    "reset-users": "ts-node -r tsconfig-paths/register src/scripts/stage/reset-users.ts",
    "update-titles": "ts-node -r tsconfig-paths/register src/scripts/production/update-listing-titles.ts",
    "update-engine-volumes": "ts-node -r tsconfig-paths/register src/scripts/stage/update-engine-volumes.ts",
    "update-listing-dates": "ts-node -r tsconfig-paths/register src/scripts/stage/update-listing-dates.ts",
    "sync-carquery": "ts-node -r tsconfig-paths/register src/scripts/stage/sync-carquery.ts",
    "sort-imports": "ts-node -r tsconfig-paths/register scripts/sort-imports.ts",
    "cleanup-brands": "ts-node -r tsconfig-paths/register src/scripts/stage/cleanup-brands.ts",
    "clear-database": "ts-node -r tsconfig-paths/register src/scripts/stage/clear-database.ts",
    "clear-listings": "ts-node -r tsconfig-paths/register src/scripts/stage/clear-listings.ts",
    "add-brands": "ts-node -r tsconfig-paths/register src/scripts/stage/add-brands.ts",
    "add-truck-brands": "ts-node -r tsconfig-paths/register src/scripts/stage/add-truck-brands-models.ts",
    "add-moto-brands": "ts-node -r tsconfig-paths/register src/scripts/stage/add-motorcycle-brands-models.ts",
    "seed:all-brands": "ts-node -r tsconfig-paths/register src/scripts/stage/seed-all-brands.ts",
    "add-models": "ts-node -r tsconfig-paths/register src/scripts/stage/add-models-to-brand.ts",
    "add-historical": "ts-node -r tsconfig-paths/register src/scripts/stage/add-historical-models.ts",
    "add-grand": "ts-node -r tsconfig-paths/register src/scripts/stage/add-grand-models.ts",
    "add-french-models": "ts-node -r tsconfig-paths/register src/scripts/stage/add-french-brands-models.ts",
    "add-german-models": "ts-node -r tsconfig-paths/register src/scripts/stage/add-german-brands-models.ts",
    "add-italian-models": "ts-node -r tsconfig-paths/register src/scripts/stage/add-italian-brands-models.ts",
    "add-japanese-models": "ts-node -r tsconfig-paths/register src/scripts/stage/add-japanese-brands-models.ts",
    "add-american-models": "ts-node -r tsconfig-paths/register src/scripts/stage/add-american-brands-models.ts",
    "add-commercial-models": "ts-node -r tsconfig-paths/register src/scripts/stage/add-commercial-models.ts",
    "add-other-model": "ts-node -r tsconfig-paths/register src/scripts/stage/add-other-model.ts",
    "delete-all-brands": "ts-node -r tsconfig-paths/register src/scripts/stage/delete-all-brands.ts",
    "check-brands": "ts-node -r tsconfig-paths/register src/scripts/stage/check-brands-count.ts",
    "check-models": "ts-node -r tsconfig-paths/register src/scripts/stage/check-models-stats.ts",
    "check-citroen": "ts-node -r tsconfig-paths/register src/scripts/stage/check-citroen-models.ts",
    "check-duplicates": "ts-node -r tsconfig-paths/register src/scripts/stage/check-duplicates.ts",
    "remove-duplicates": "ts-node -r tsconfig-paths/register src/scripts/stage/remove-duplicates.ts",
    "check-user": "ts-node -r tsconfig-paths/register src/scripts/stage/check-user.ts",
    "generate-listings-for-models": "ts-node -r tsconfig-paths/register src/scripts/stage/generate-listings-for-all-models.ts",
    "backup": "ts-node -r tsconfig-paths/register src/scripts/production/backup-database.ts",
    "upload-robots-txt": "ts-node -r tsconfig-paths/register src/scripts/production/upload-robots-txt.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@nestjs/cli": "^10.2.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^10.0.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.10",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.2",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.10.4",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@jest/test-sequencer": "^30.2.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^7.0.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.1.2",
    "jest": "^29.7.0",
    "jest-openapi": "^0.14.2",
    "prettier": "^3.1.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.51.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "transformIgnorePatterns": [
      "<rootDir>/../dist/"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
