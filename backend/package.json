    "cipauto:report": "ts-node -r ./scripts/partner-import-cli-preload.cjs -r tsconfig-paths/register src/scripts/tools/cipauto-import/cli.ts report",
    "cipauto:seed-registry": "ts-node -r ./scripts/partner-import-cli-preload.cjs src/scripts/tools/cipauto-import/commands/seed-registry.ts",
    "cipauto:audit-stale": "ts-node -r ./scripts/partner-import-cli-preload.cjs src/scripts/tools/cipauto-import/commands/audit-stale-listings.ts",
    "999md:scan": "ts-node -r ./scripts/partner-import-cli-preload.cjs -r tsconfig-paths/register src/scripts/tools/999md-import/cli.ts scan",
    "999md:import": "ts-node -r ./scripts/partner-import-cli-preload.cjs -r tsconfig-paths/register src/scripts/tools/999md-import/cli.ts import",
    "999md:report": "ts-node -r ./scripts/partner-import-cli-preload.cjs -r tsconfig-paths/register src/scripts/tools/999md-import/cli.ts report",
    "999md:seed-registry": "ts-node -r ./scripts/partner-import-cli-preload.cjs -r tsconfig-paths/register src/scripts/tools/999md-import/commands/seed-registry.ts",
