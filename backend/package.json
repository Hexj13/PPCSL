    "fix-tank-haval-model-names:prod": "ts-node -r tsconfig-paths/register src/scripts/production/fix-tank-haval-model-names.ts",
    "check-empty-brands:prod": "ts-node -r tsconfig-paths/register src/scripts/production/check-empty-brands.ts",
    "fix-empty-brands": "ts-node -r tsconfig-paths/register src/scripts/stage/fix-empty-brand-names.ts",
    "fix-empty-brands:prod": "ts-node -r tsconfig-paths/register src/scripts/production/fix-empty-brand-names.ts",
    "remove-other-brand": "ts-node -r tsconfig-paths/register src/scripts/stage/remove-other-brand.ts",
    "remove-other-brand:prod": "ts-node -r tsconfig-paths/register src/scripts/production/remove-other-brand.ts",
    "remove-body-code-models": "ts-node -r tsconfig-paths/register src/scripts/stage/remove-body-code-models.ts",
