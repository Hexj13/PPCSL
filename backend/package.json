{
  "name": "kupito-backend",
  "version": "1.0.0",
  "description": "Backend API для Kupito",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "npm exec --yes --package=@nestjs/cli@11.0.16 nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "start": "npx nest start",
    "start:dev": "npx nest start --watch",
    "start:debug": "npx nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" --fix --ignore-pattern '*.spec.ts' --ignore-pattern '*.test.ts' --ignore-pattern '*.integration.ts' --ignore-pattern 'src/test/**'",
    "lint:check": "eslint \"src/**/*.ts\" --ignore-pattern '*.spec.ts' --ignore-pattern '*.test.ts' --ignore-pattern '*.integration.ts' --ignore-pattern 'src/test/**'",
    "test": "jest",
    "test:ci": "jest --maxWorkers=50%",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules --no-deprecation' jest --config config/jest-integration.config.cjs",
    "test:integration:watch": "NODE_OPTIONS='--experimental-vm-modules --no-deprecation' jest --config config/jest-integration.config.cjs --watch",
    "migration:generate": "node node_modules/typeorm/cli-ts-node-commonjs.js migration:generate -d src/data-source.cli.ts",
    "migration:run": "node node_modules/typeorm/cli-ts-node-commonjs.js migration:run -d src/data-source.cli.ts",
    "migration:run:prod": "node node_modules/typeorm/cli.js migration:run -d dist/data-source.migration-run.js",
    "migration:revert": "node node_modules/typeorm/cli-ts-node-commonjs.js migration:revert -d src/data-source.cli.ts",
    "migration:revert:prod": "node node_modules/typeorm/cli.js migration:revert -d dist/data-source.migration-run.js",
    "seed": "ts-node -r tsconfig-paths/register src/scripts/stage/seed.ts",
    "reset-and-seed": "ts-node -r tsconfig-paths/register src/scripts/stage/reset-and-seed.ts",
    "clear-cache": "ts-node -r tsconfig-paths/register src/scripts/stage/clear-cache.ts",
    "clear-cache:prod": "ts-node -r tsconfig-paths/register src/scripts/production/clear-cache.ts",
    "clear-cache:listings": "ts-node -r tsconfig-paths/register src/scripts/stage/clear-listing-cache.ts",
