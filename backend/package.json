    "add-other-model": "ts-node -r tsconfig-paths/register src/scripts/stage/add-other-model.ts",
    "delete-all-brands": "ts-node -r tsconfig-paths/register src/scripts/stage/delete-all-brands.ts",
    "check-brands": "ts-node -r tsconfig-paths/register src/scripts/stage/check-brands-count.ts",
    "check-models": "ts-node -r tsconfig-paths/register src/scripts/stage/check-models-stats.ts",
