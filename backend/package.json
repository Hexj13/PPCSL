    "check-brands:prod": "ts-node -r tsconfig-paths/register src/scripts/production/check-brands-count.ts",
    "check-models:prod": "ts-node -r tsconfig-paths/register src/scripts/production/check-models-stats.ts",
    "reset-users": "ts-node -r tsconfig-paths/register src/scripts/stage/reset-users.ts",
    "update-titles": "ts-node -r tsconfig-paths/register src/scripts/production/update-listing-titles.ts",
    "update-engine-volumes": "ts-node -r tsconfig-paths/register src/scripts/stage/update-engine-volumes.ts",
    "update-listing-dates": "ts-node -r tsconfig-paths/register src/scripts/stage/update-listing-dates.ts",
