    "999md:dealer-audit": "ts-node -r ./scripts/partner-import-cli-preload.cjs -r tsconfig-paths/register src/scripts/tools/999md-import/tools/dealer-brand-model-audit.ts",
    "check-duplicates": "ts-node -r tsconfig-paths/register src/scripts/stage/check-duplicates.ts",
    "check-brand-model-name-duplicates": "ts-node -r tsconfig-paths/register src/scripts/stage/check-brand-model-name-duplicates.ts",
    "remove-duplicates": "ts-node -r tsconfig-paths/register src/scripts/stage/remove-duplicates.ts",
    "check-user": "ts-node -r tsconfig-paths/register src/scripts/stage/check-user.ts",
    "generate-listings-for-models": "ts-node -r tsconfig-paths/register src/scripts/stage/generate-listings-for-all-models.ts",
    "backup": "ts-node -r tsconfig-paths/register src/scripts/production/backup-database.ts",
    "upload-robots-txt": "ts-node -r tsconfig-paths/register src/scripts/production/upload-robots-txt.ts",
    "backfill:blurhash:cover": "ts-node -r tsconfig-paths/register src/scripts/tools/backfill-blurhash.ts",
    "backfill:blurhash:all": "ts-node -r tsconfig-paths/register src/scripts/tools/backfill-blurhash.ts all",
    "backfill:blurhash:cover:prod": "node dist/scripts/tools/backfill-blurhash.js",
    "backfill:blurhash:all:prod": "node dist/scripts/tools/backfill-blurhash.js all"
  },
