PORT=4000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=kupito
DB_PASSWORD=kupito123
DB_NAME=kupito
JWT_SECRET=your-secret-key-change-in-production
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
REDIS_HOST=localhost
REDIS_PORT=6379
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_MESSAGING_SERVICE_SID=your-twilio-messaging-service-sid
# INFOCAR_SECRET_KEY=your-infocar-secret-key

# Optional: CipAuto Cloudflare bypass (docker compose service flaresolverr in core/)
# CIPAUTO_FLARESOLVERR_URL=http://127.0.0.1:8191
# CIPAUTO_FLARESOLVERR_TIMEOUT_MS=60000

# Watermark / plate-mask domain text (fallback: FRONTEND_URL hostname)
# WATERMARK_DOMAIN=your-domain.com

# Logging (optional; defaults to info in production, debug otherwise)
# LOG_LEVEL=info

# Site / Swagger branding (optional)
# SITE_NAME=Your Platform
# PLATFORM_NAME=Your Platform

# OAuth / social (optional)
# GOOGLE_CLIENT_ID=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_SUPPORT_CHAT_ID=

# Sentry (optional; environment = NODE_ENV; SENTRY_ENVIRONMENT / SENTRY_RELEASE are not read)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.05

# Promotions / admin parsing (optional)
# PROMOTION_ACCESS=disabled
# ADMIN_PARSING_SCHEDULER_ENABLED=false

# AWS S3 (required on ephemeral hosts such as Render)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET_NAME=
# AWS_REGION=eu-north-1
# AWS_CLOUDFRONT_URL=https://cdn.your-domain.com

# Listing video / MediaConvert (optional)
# AWS_MEDIACONVERT_ENDPOINT=
# AWS_MEDIACONVERT_QUEUE_ARN=
# AWS_MEDIACONVERT_ROLE_ARN=
# AWS_MEDIACONVERT_SNS_TOPIC_ARN=
# LISTING_VIDEO_WATERMARK_S3_URI=
# VIDEO_MAX_SIZE_BYTES=
# VIDEO_MAX_DURATION_SEC=

# Gemini AI listing report (optional)
# GEMINI_API_KEY=
