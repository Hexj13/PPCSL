*storybook.log
storybook-static

# Platform-specific files (should be in platform repositories, not in core)
# Already-tracked files are not affected by this rule; only new files are ignored.
# To track a new config file in core, add a negation (!path) below.
frontend/lib/config/
!frontend/lib/config/parsers.ts
frontend/lib/locales/*.json
!frontend/lib/locales/en.json
frontend/lib/theme/colors.ts
frontend/next-env.d.ts

# Platform-specific assets (copied from platform repos during build)
frontend/public/favicon*.png
frontend/public/favicon.ico
frontend/public/logo*.png
frontend/public/og-image.jpg
frontend/public/opengraph-image.png
frontend/public/pwa192.png
frontend/public/partners/
backend/assets/watermark/logo.png

# Legacy native app path — use platform android/twa/ instead
mobile/

