# Uploads (local)
# But keep seed-images for all platforms to use
!backend/uploads/seed-images/
uploads/
public/uploads/
backend/src/scripts/tools/cipauto-import/data/
backend/src/scripts/tools/cipauto-import/reports/
backend/src/scripts/tools/999md-import/data/
backend/src/scripts/tools/999md-import/reports/
