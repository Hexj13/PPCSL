# Эмулятор Android: 10.0.2.2 = хост с Mac/PC
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Expo / браузер на той же машине, что и backend
# EXPO_PUBLIC_API_URL=http://127.0.0.1:4000

# Физическое устройство (та же Wi‑Fi): укажите LAN-IP машины, где крутится backend (например ipconfig getifaddr en0)
# EXPO_PUBLIC_API_URL=http://192.168.1.42:4000

# Staging / prod — задавайте в EAS Secrets или перед запуском:
# EXPO_PUBLIC_API_URL=https://api.example.com

EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_EAS_PROJECT_ID=
