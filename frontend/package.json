{
  "name": "ppcsl-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "rm -rf .next && next dev",
    "dev:clean": "rm -rf .next node_modules/.cache && next dev",
    "generate:sitemap": "ts-node --transpile-only --compiler-options '{\"module\":\"commonjs\"}' scripts/generate-sitemap.ts",
    "prebuild": "npm run generate:sitemap || true",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . -c config/eslint.config.mjs && npm run lint:translations",
    "lint:fix": "eslint . -c config/eslint.config.mjs --fix",
    "lint:styles": "stylelint \"**/*.css\" --config config/stylelint.config.js --ignore-pattern \"coverage/**\" --ignore-pattern \".next/**\"",
    "lint:styles:fix": "stylelint \"**/*.css\" --config config/stylelint.config.js --fix --ignore-pattern \"coverage/**\" --ignore-pattern \".next/**\"",
    "lint:translations": "ts-node --transpile-only --compiler-options '{\"module\":\"commonjs\"}' scripts/check-translations-sync.ts",
    "lint:all": "npm run lint && npm run lint:styles && npm run lint:translations",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css,md}\"",
    "test": "NODE_OPTIONS='--max-old-space-size=16384' jest --runInBand",
    "test:watch": "NODE_OPTIONS='--max-old-space-size=8192' jest --watch",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=16384' jest --coverage --maxWorkers=1",
    "sort-imports": "ts-node --transpile-only --compiler-options '{\"module\":\"commonjs\"}' scripts/sort-imports.ts",
    "storybook": "node scripts/storybook-with-info.js",
    "storybook:dev": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.37.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.10.0",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.9",
    "dompurify": "^3.3.0",
    "next": "^16.0.1",
    "postcss": "^8.4.49",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.4.1",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.7.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.2",
    "@storybook/addon-a11y": "^10.0.5",
    "@storybook/addon-docs": "^10.0.5",
    "@storybook/addon-onboarding": "^10.0.5",
    "@storybook/addon-vitest": "^10.0.5",
    "@storybook/nextjs-vite": "^10.0.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitest/browser-playwright": "^4.0.7",
    "@vitest/coverage-v8": "^4.0.7",
    "baseline-browser-mapping": "^2.9.15",
    "browserslist": "^4.28.1",
    "critters": "^0.0.23",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^10.0.5",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "playwright": "^1.56.1",
    "prettier": "^3.4.2",
    "storybook": "^10.0.5",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "vitest": "^4.0.7"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "preset": "ts-jest",
    "testTimeout": 30000,
    "maxWorkers": 1,
    "workerIdleMemoryLimit": "500MB",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.next/",
      "/out/",
      "components/ListingForm.test.tsx"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/config/jest/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "\\./config/site$": "<rootDir>/lib/__mocks__/site.ts"
    },
    "testMatch": [
      "**/__tests__/**/*.[jt]s?(x)",
      "**/?(*.)+(spec|test).[jt]s?(x)"
    ],
    "collectCoverageFrom": [
      "lib/**/*.{ts,tsx}",
      "hooks/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "!**/*.d.ts",
      "!**/node_modules/**"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "tsconfig": {
            "jsx": "react"
          }
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(@testing-library|@next)/)"
    ]
  }
}
