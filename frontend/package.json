{
  "name": "ppcsl-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "rm -rf .next && next dev",
    "dev:clean": "rm -rf .next node_modules/.cache && next dev",
    "prebuild": "node ../../scripts/sync-platform-to-core.cjs && node --experimental-strip-types scripts/write-theme-json.js",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint . && npm run lint:translations",
    "lint:fix": "eslint . --fix",
    "lint:styles": "stylelint \"**/*.css\" --config config/stylelint.config.js --ignore-pattern \"coverage/**\" --ignore-pattern \".next/**\" --ignore-pattern \"allure-report/**\" --ignore-pattern \"allure-results/**\" --ignore-pattern \"playwright-report/**\" --ignore-pattern \"test-results/**\"",
    "lint:styles:fix": "stylelint \"**/*.css\" --config config/stylelint.config.js --fix --ignore-pattern \"coverage/**\" --ignore-pattern \".next/**\" --ignore-pattern \"allure-report/**\" --ignore-pattern \"allure-results/**\" --ignore-pattern \"playwright-report/**\" --ignore-pattern \"test-results/**\"",
    "lint:translations": "ts-node --transpile-only --compiler-options '{\"module\":\"commonjs\"}' scripts/check-translations-sync.ts",
    "lint:all": "npm run lint && npm run lint:styles && npm run lint:translations",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css,md}\"",
    "test": "env -u NO_COLOR NODE_OPTIONS='--max-old-space-size=16384 --no-experimental-webstorage' jest --runInBand",
    "test:ci": "env -u NO_COLOR NODE_OPTIONS='--max-old-space-size=8192 --no-experimental-webstorage' jest --maxWorkers=50% --passWithNoTests",
    "test:watch": "env -u NO_COLOR NODE_OPTIONS='--max-old-space-size=8192 --no-experimental-webstorage' jest --watch",
    "test:coverage": "env -u NO_COLOR NODE_OPTIONS='--max-old-space-size=16384 --no-experimental-webstorage' jest --coverage --maxWorkers=1",
    "test:e2e": "env -u NO_COLOR playwright test",
    "test:e2e:p0": "env -u NO_COLOR playwright test --grep @p0",
    "test:e2e:twa": "env -u NO_COLOR playwright test e2e/specs/twa-mobile-smoke.spec.ts --project=mobile",
    "test:lighthouse:ci": "lhci autorun --config=lighthouserc.cjs",
    "test:e2e:headed": "env -u NO_COLOR playwright test --headed",
    "test:e2e:ui": "env -u NO_COLOR playwright test --ui",
    "test:e2e:allure:generate": "allure generate allure-results --clean -o allure-report",
    "test:e2e:allure:open": "allure open allure-report",
    "test:e2e:allure": "npm run test:e2e && npm run test:e2e:allure:generate",
    "perf:list-grid": "node scripts/perf/list-perf.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sort-imports": "ts-node --transpile-only --compiler-options '{\"module\":\"commonjs\"}' scripts/sort-imports.ts",
    "knip": "knip",
    "storybook": "node scripts/storybook-with-info.js",
    "storybook:dev": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/nextjs": "^10.40.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-virtual": "^3.14.2",
    "@types/node": "^24.10.0",
    "@types/react-dom": "^19.2.3",
    "axios": "^1.7.9",
    "blurhash": "^2.0.5",
    "dompurify": "^3.4.0",
    "jose": "^6.0.10",
    "libphonenumber-js": "^1.12.42",
    "next": "^16.0.1",
    "postcss": "^8.5.10",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hot-toast": "^2.4.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.7.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.3.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-onboarding": "^10.5.8",
    "@storybook/addon-vitest": "^10.5.8",
    "@storybook/nextjs-vite": "^10.5.8",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.0.7",
    "allure-commandline": "^2.43.0",
    "allure-js-commons": "3.10.2",
    "allure-playwright": "^3.7.1",
    "baseline-browser-mapping": "^2.11.14",
    "browserslist": "^4.28.8",
    "critters": "^0.0.25",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.8",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^29.7.0",
    "knip": "^5.62.0",
    "playwright": "^1.58.2",
    "prettier": "^3.9.6",
    "storybook": "^10.2.13",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "vitest": "^4.0.7"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "preset": "ts-jest",
    "testTimeout": 30000,
    "maxWorkers": 1,
    "workerIdleMemoryLimit": "500MB",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.next/",
      "/out/",
      "/e2e/specs/",
      "/e2e/page-objects/",
      "/e2e/components/",
      "/e2e/utils/",
      "/e2e/fixtures/",
      "/e2e/test-data/",
      "/e2e/types/",
      "/e2e/constants/"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 15,
        "functions": 12,
        "lines": 20,
        "statements": 20
      }
    },
    "setupFilesAfterEnv": [
      "<rootDir>/config/jest/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/lib/blurhash-worker-client$": "<rootDir>/lib/__mocks__/blurhash-worker-client.ts",
      "^@/(.*)$": "<rootDir>/$1",
      "\\./config/site$": "<rootDir>/lib/__mocks__/site.ts"
    },
    "testMatch": [
      "**/__tests__/**/*.[jt]s?(x)",
      "**/?(*.)+(spec|test).[jt]s?(x)"
    ],
    "collectCoverageFrom": [
      "lib/**/*.{ts,tsx}",
      "hooks/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "!**/*.d.ts",
      "!**/node_modules/**"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "tsconfig": {
            "jsx": "react"
          }
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(@testing-library|@next)/)"
    ]
  }
}
